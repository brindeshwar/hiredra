# Secrets
.env

# Virtual environment
.venv/

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Cloned source repos (harvested from, never committed)
reference/

# Graphify codebase-graph output (local navigation aid, not a deliverable)
graphify-out/

# Runtime & personal data — master profile, built graph, ledger.
# Holds personal/application data and large files. Never commit contents;
# keep the folder itself tracked via the .gitkeep exception below.
data/*
!data/.gitkeep

# Staging folder for the off-machine copy (backups + archives); moved off this PC by hand
offsite/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Build spec — kept local-only, not published to the repo
CLAUDE.md
docs/

# Generated Path-1 company list for max-scale sourcing runs — regenerable
# data (scripts/generate_company_list.py), not hand-authored config. The
# curated config/companies.yml stays tracked.
config/companies.wide.yml
