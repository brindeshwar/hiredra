# Hiredra environment variables.
# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM providers (free tier only, per CLAUDE.md rule 2) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# More keys are added here as each build slice needs them
# (e.g. notification channel in step 9). Keep .env.example in sync.

# --- Backup (scripts/backup_private.py, plan unit BK1) ---
# A private folder OUTSIDE the repo, ideally cloud-synced (e.g. a personal drive).
HIREDRA_BACKUP_DIR=

# --- Postgres (docker-compose.yml; plan unit DB1) ---
# Any long random string. docker compose reads it; Hiredra connects with HIREDRA_DATABASE_URL.
HIREDRA_PG_PASSWORD=
HIREDRA_DATABASE_URL=postgresql://hiredra:<HIREDRA_PG_PASSWORD>@127.0.0.1:5432/hiredra
# Optional: a server the DB tests may create and drop scratch databases on (CI sets it).
# HIREDRA_TEST_DATABASE_URL=postgresql://hiredra:<password>@127.0.0.1:5432/postgres
